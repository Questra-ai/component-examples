<script>/* Runs inline in the head, before body parsing; no jQuery dependency. */
(function () {
  'use strict';
  var root = document.documentElement;
  var expired = false;
  root.classList.add('qt-pending');
  function reveal(fallback) {
    if (fallback) expired = true;
    root.classList.remove('qt-pending');
  }
  window.QuestraTheme = {
    canEnhance: function () { return !expired; },
    ready: function () { reveal(false); }
  };
  setTimeout(function () { reveal(true); }, 1800);
  // Keyboard/pointer intent takes precedence over cosmetic loading.
  document.addEventListener('keydown', function () { reveal(true); }, {once:true,capture:true});
  document.addEventListener('pointerdown', function () { reveal(true); }, {once:true,capture:true});
  window.addEventListener('pageshow', function (event) { if (event.persisted) reveal(true); });

})();

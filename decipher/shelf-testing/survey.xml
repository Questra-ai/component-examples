<exec when="init"><![CDATA[
def shelfLoadDesign(fname):
    f = open("%s/%s" % (gv.survey.path, fname))
    records = [line.strip("\r\n").split("\t") for line in f.readlines() if line.strip()]
    f.close()
    if records[0] != ["Version", "Task", "Concept", "Product", "Shelf", "Position", "Price", "Available"]:
        raise ValueError("Unexpected shelf design header")
    design = {}
    for row in records[1:]:
        if len(row) != 8:
            raise ValueError("Invalid shelf design row")
        values = [int(n) for n in row]
        key = "v%s_t%s_c%s" % (values[0],values[1],values[2])
        if key in design:
            raise ValueError("Duplicate shelf design key")
        design[key] = values[3:]
    return design
shelfDesign = shelfLoadDesign("shelf-design-v1.dat")
def shelfOffers(version):
    offers = []
    for slot in range(1,7):
        a = shelfDesign["v%s_t1_c%s" % (version,slot)]
        offers.append({"slot":slot, "product":"p%s" % a[0], "shelf":a[1], "position":a[2], "price":a[3], "available":a[4]})
    return offers
]]></exec>


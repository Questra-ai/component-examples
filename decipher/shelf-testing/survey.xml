var question=document.getElementById('question_'+meta.dataset.label)||document.querySelector('.shelf-native');
if(!next||!form||!question)return;
var inventory=[
 {id:'p101',name:'Oatfield Honey & Almond',brand:'Oatfield',flavor:'Honey & Almond',sprite:0},
 {id:'p102',name:'Oatfield Maple & Pecan',brand:'Oatfield',flavor:'Maple & Pecan',sprite:1},
 {id:'p103',name:'Oatfield Berry & Seed',brand:'Oatfield',flavor:'Berry & Seed',sprite:2},
 {id:'p104',name:'Morning Folk Cocoa & Hazelnut',brand:'Morning Folk',flavor:'Cocoa & Hazelnut',sprite:3},
 {id:'p105',name:'Morning Folk Coconut & Chia',brand:'Morning Folk',flavor:'Coconut & Chia',sprite:4},
 {id:'p106',name:'Morning Folk Apple & Cinnamon',brand:'Morning Folk',flavor:'Apple & Cinnamon',sprite:5}
],items={},inputs={},offers;
inventory.forEach(function(p){items[p.id]=p;});
offers=Array.from(meta.querySelectorAll('[data-slot]')).map(function(e){return {slot:Number(e.dataset.slot),product:e.dataset.product,shelf:Number(e.dataset.shelf),position:Number(e.dataset.position),price:Number(e.dataset.price),available:Number(e.dataset.available)};});
Array.from(question.querySelectorAll('input[type="radio"]')).forEach(function(input){
 var label=question.querySelector('label[for="'+input.id+'"]'),tag=label&&label.querySelector('[data-product]');
 var product=tag?tag.dataset.product:null;
 if(!product&&label){var known=inventory.find(function(p){return p.name===label.textContent.trim();});if(known)product=known.id;}
 if(product)inputs[product]=input;
});
if(!Array.isArray(offers)||offers.length!==6||offers.some(function(o){return !items[o.product]||!Number.isInteger(o.slot)||!Number.isInteger(o.price)||(o.available===1&&!inputs[o.product]);}))return;
var key='shelf:'+location.pathname+':'+meta.dataset.label+':'+meta.dataset.session+':'+meta.dataset.design+':'+meta.dataset.version;
var selected=null,submitted=false,ui=document.createElement('main');
var money=function(cents){return '$'+(cents/100).toFixed(2);};
var position=function(product){var s=items[product].sprite;return (s%3*50)+'% '+(s<3?0:100)+'%';};
var esc=function(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});};
ui.className='sh-ui';ui.setAttribute('aria-label','Shelf selection');ui.style.setProperty('--sh-atlas','url("'+meta.dataset.assets+'granola-atlas.png")');
ui.innerHTML='<header class="sh-heading"><h1>Which granola would you choose?</h1><p>Select one product from the shelf. You can change your choice before continuing.</p></header><div class="sh-rack" role="radiogroup" aria-label="Granola products" aria-required="true" aria-describedby="sh-error"></div><div class="sh-bottom"><div class="sh-selection"><div class="sh-selection-thumb" aria-hidden="true"></div><div><p class="sh-selection-title">Choose a product from the shelf</p><p class="sh-selection-detail">All packs 350 g · Prices in USD</p></div></div><button type="button" class="sh-next"><span>Continue</span><span class="sh-next-arrow" aria-hidden="true">→</span></button></div><p class="sh-error" id="sh-error" role="alert"></p><span class="sh-sr" role="status" aria-live="polite"></span>';
var rack=ui.querySelector('.sh-rack'),error=ui.querySelector('.sh-error'),status=ui.querySelector('[role="status"]'),submit=ui.querySelector('.sh-next');
[1,2].forEach(function(level){
 var tier=document.createElement('div');tier.className='sh-tier';tier.setAttribute('role','presentation');rack.appendChild(tier);
 offers.filter(function(o){return o.shelf===level;}).sort(function(a,b){return a.position-b.position;}).forEach(function(o){
  var p=items[o.product],slot=document.createElement('div');slot.className='sh-slot';slot.dataset.slot=o.slot;slot.dataset.product=o.product;
  var packs='<i class="sh-floor-shadow" aria-hidden="true"></i><i class="sh-pack back" aria-hidden="true" style="background-position:'+position(p.id)+'"></i><i class="sh-pack front" aria-hidden="true" style="background-position:'+position(p.id)+'"></i>';
  if(o.available===1){slot.innerHTML='<button class="sh-product" type="button" role="radio" aria-checked="false" data-product="'+p.id+'" aria-label="'+esc(p.name+', 350 grams, '+money(o.price))+'" tabindex="-1">'+packs+'<span class="sh-check" aria-hidden="true">✓</span></button>';}
  else{slot.innerHTML='<div class="sh-empty" aria-label="'+esc(p.name+' unavailable')+'">'+packs+'<span class="sh-unavailable">Unavailable</span></div>';}
  slot.innerHTML+='<div class="sh-ticket" aria-hidden="true"><div class="sh-ticket-copy"><div class="sh-ticket-name">'+esc(p.flavor)+'</div><div class="sh-ticket-size">350 g<span class="sh-barcode"></span></div></div><div class="sh-price"><small>$</small>'+(o.price/100).toFixed(2)+'</div></div>';
  tier.appendChild(slot);
 });
});
var buttons=Array.from(ui.querySelectorAll('.sh-product'));
function update(announce){
 buttons.forEach(function(b,i){var checked=b.dataset.product===selected;b.setAttribute('aria-checked',checked?'true':'false');b.tabIndex=selected?(checked?0:-1):(i===0?0:-1);});
 var p=selected&&items[selected],o=offers.find(function(x){return x.product===selected;});
 var summary=ui.querySelector('.sh-selection');summary.classList.toggle('has-choice',!!p);
 ui.querySelector('.sh-selection-title').textContent=p?p.name:'Choose a product from the shelf';
 ui.querySelector('.sh-selection-detail').textContent=p?money(o.price)+' · 350 g':'All packs 350 g · Prices in USD';
 if(p)ui.querySelector('.sh-selection-thumb').style.backgroundPosition=position(p.id);
 if(announce&&p)status.textContent=p.name+', '+money(o.price)+', selected.';
}
function choose(id,focus){
 if(submitted||!inputs[id]||!offers.some(function(o){return o.product===id&&o.available===1;}))return;
 inputs[id].click();selected=id;error.textContent='';rack.removeAttribute('aria-invalid');
 try{sessionStorage.setItem(key,id);}catch(e){}
 update(true);if(focus)buttons.find(function(b){return b.dataset.product===id;}).focus();
}
buttons.forEach(function(b){
 b.addEventListener('click',function(){choose(b.dataset.product,false);});
 b.addEventListener('keydown',function(e){
  var direction={ArrowLeft:-1,ArrowUp:-3,ArrowRight:1,ArrowDown:3}[e.key],index=buttons.indexOf(b),target;
  if(direction){e.preventDefault();target=(index+direction+buttons.length*2)%buttons.length;choose(buttons[target].dataset.product,true);}
  else if(e.key==='Home'||e.key==='End'){e.preventDefault();choose(buttons[e.key==='Home'?0:buttons.length-1].dataset.product,true);}
 });
});
var restored=Object.keys(inputs).find(function(id){return inputs[id].checked;});
if(!restored){try{restored=sessionStorage.getItem(key);}catch(e){}}
if(restored&&inputs[restored]){inputs[restored].click();selected=restored;}

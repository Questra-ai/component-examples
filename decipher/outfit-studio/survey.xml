<exec when="init"><![CDATA[
def setupDCMFile(fname, fileDelimiter="\t"):
    f = open("%s/%s" % (gv.survey.path, fname))
    rows = [line.strip("\r\n").split(fileDelimiter) for line in f.readlines()]
    f.close()
    d = {}
    for row in rows[1:]:
        if len(row) == 7:
            d["v%s_t%s_c%s" % (row[0],row[1],row[2])] = row[3:]
    return d
outfitDesign = setupDCMFile("outfit-design-v2.dat")
def outfitOffers(version, task, attribute):
    return [int(outfitDesign["v%s_t%s_c%s" % (version,task,c)][attribute]) for c in range(1,4)]
]]></exec>
